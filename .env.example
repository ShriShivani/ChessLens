# Copy to .env and fill in. Never commit .env.

# --- Server ---
DATABASE_URL=sqlite:///./chesslens.db
# Shared secret the edge client sends on /ws/ingest. Generate a long random value.
INGEST_TOKEN=change-me
# Comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:5173
# Optional Stockfish evaluation (COULD item)
STOCKFISH_ENABLED=false
STOCKFISH_PATH=
STOCKFISH_DEPTH=12
STOCKFISH_TIME_MS=200

# --- Edge client ---
SERVER_URL=ws://localhost:8000
# Camera source: device index (e.g. 0), http(s)/rtsp URL, or a video file path
CAMERA_SOURCE=0
STABILITY_SECONDS=0.7

# --- Web ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
